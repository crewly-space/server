{
  "name": "opencrew-server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "The self-hostable OpenCrew server. Owns the wire protocol and the client SDK.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:migrations && tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "build:migrations": "node scripts/embed-migrations.mjs",
    "build:binary": "bun run scripts/build-binary.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fetch:app": "node scripts/fetch-app.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=24"
  }
}
