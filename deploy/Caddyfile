# TLS termination for a self-hosted Crewly server.
#
# Set CREWLY_DOMAIN and ACME_EMAIL, then run this next to compose.yaml:
#   CREWLY_DOMAIN=crew.example.com ACME_EMAIL=you@example.com \
#     docker compose -f compose.yaml -f compose.proxy.yaml up -d
#
# The server serves the API, the WebSocket hub, and the app on one port, so
# there is a single upstream. Caddy upgrades WebSocket connections itself.

{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$CREWLY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The server reads the client address from these to rate-limit by real IP,
	# which is why it runs with CREWLY_TRUST_PROXY=true behind this.
	reverse_proxy crewly:8787 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
