[Unit]
Description=Crewly self-hosted server
Documentation=https://crewly.space/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crewly
Group=crewly
Environment=CREWLY_DATA_DIR=@@DATA@@
Environment=CREWLY_PORT=@@PORT@@
Environment=CREWLY_HOST=127.0.0.1
ExecStart=@@BIN@@
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@DATA@@
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
